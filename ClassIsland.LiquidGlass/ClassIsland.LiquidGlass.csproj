<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <AssemblyName>ClassIsland.LiquidGlass</AssemblyName>
    <RootNamespace>ClassIsland.LiquidGlass</RootNamespace>
    <Version>1.0.0</Version>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Keep host assemblies out of the plugin package: ClassIsland loads them itself. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.17" ExcludeAssets="runtime" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.4.1" ExcludeAssets="runtime" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Place this folder next to the official sample plugin folder inside the ClassIsland source tree. -->
  <ItemGroup>
    <ProjectReference Include="../../ClassIsland.Core/ClassIsland.Core.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../ClassIsland/ClassIsland.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Themes\**" />
    <None Include="manifest.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
